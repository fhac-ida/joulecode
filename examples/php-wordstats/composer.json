{
    "name": "joulecode/php-wordstats",
    "description": "joule:code example: text statistics in PHP with typical inefficiencies",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "WordStats\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "WordStats\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
