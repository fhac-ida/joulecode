+// Holidays as a set per calendar and holiday list (rebuilt when the list changes).
+const holidaySets = new WeakMap();
+
+function holidaySet(calendar) {
+  const cached = holidaySets.get(calendar);
+  if (cached && cached.list === calendar.holidays && cached.size === calendar.holidays.length) {
+    return cached.set;
+  }
+  const set = new Set(calendar.holidays);
+  holidaySets.set(calendar, { list: calendar.holidays, size: calendar.holidays.length, set });
+  return set;
+}
+
 export function isHoliday(t, calendar = DEFAULT_CALENDAR) {
-  return calendar.holidays.includes(isoDate(t));
+  return holidaySet(calendar).has(isoDate(t));
+}
+
+/**
+ * How many minutes from `t` on (same seconds offset) are business time in a row (> 0)
+ * or not business time in a row (< 0, at most until the end of the day)? Basis for the jumps below.
+ */
+function runAt(t, calendar) {
+  const d = new Date(t);
+  const minuteOfDay = d.getUTCHours() * 60 + d.getUTCMinutes();
+  const span = calendar.hours[d.getUTCDay()];
+  if (!span || holidaySet(calendar).has(isoDate(t)) || minuteOfDay >= span[1]) {
+    return -(1440 - minuteOfDay);
+  }
+  if (minuteOfDay < span[0]) {
+    return -(span[0] - minuteOfDay);
+  }
+  return span[1] - minuteOfDay;
 }
 
