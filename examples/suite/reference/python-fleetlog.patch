+class _FuelIndex:
+    """Reports per vehicle, stably sorted by time (same time: input order)."""
 
+    def __init__(self, events: Sequence[FuelEvent]) -> None:
+        levels: dict[str, list[FuelEvent]] = defaultdict(list)
+        refuels: dict[str, list[FuelEvent]] = defaultdict(list)
+        for e in events:
+            if e.kind == "level":
+                levels[e.vehicle_id].append(e)
+            elif e.kind == "refuel":
+                refuels[e.vehicle_id].append(e)
+        self.levels = {vid: sorted(evs, key=lambda e: e.ts) for vid, evs in levels.items()}
+        self.level_ts = {vid: [e.ts for e in evs] for vid, evs in self.levels.items()}
+        self.refuels = {vid: sorted(evs, key=lambda e: e.ts) for vid, evs in refuels.items()}
+        self.refuel_ts = {vid: [e.ts for e in evs] for vid, evs in self.refuels.items()}
+
+    def level_before(self, vehicle_id: str, ts: datetime) -> FuelEvent | None:
+        times = self.level_ts.get(vehicle_id)
+        if not times:
+            return None
+        i = bisect_right(times, ts) - 1
+        if i < 0 or times[i] < ts - LEVEL_WINDOW:
+            return None
+        i = bisect_left(times, times[i])  # at the same time the first report applies
+        return self.levels[vehicle_id][i]
+
+    def level_after(self, vehicle_id: str, ts: datetime) -> FuelEvent | None:
+        times = self.level_ts.get(vehicle_id)
+        if not times:
+            return None
+        i = bisect_left(times, ts)
+        if i == len(times) or times[i] > ts + LEVEL_WINDOW:
+            return None
+        return self.levels[vehicle_id][i]
+
+    def refuels_between(self, vehicle_id: str, a: datetime, b: datetime) -> float:
+        times = self.refuel_ts.get(vehicle_id)
+        if not times:
+            return 0
+        evs = self.refuels[vehicle_id][bisect_left(times, a) : bisect_right(times, b)]
+        return sum(e.value for e in evs)
 
