# joule:code settings – one place for everything you would otherwise pass on every command.
#
# `scripts/install.sh` creates `.joulecode.env` from this file, fills in the METRION and Ollama
# lines and makes `source .venv/bin/activate` load it. Re-running the script only updates the
# lines it manages; everything else you set here is kept.
# Without the installer: `cp .joulecode.env.example .joulecode.env`, then
#   echo '[ -f "$VIRTUAL_ENV/../.joulecode.env" ] && . "$VIRTUAL_ENV/../.joulecode.env"' >> .venv/bin/activate
#
# Every variable is optional – the values shown are the defaults. A command-line option always
# wins over a variable. Reference: docs/configuration.md#environment-variables-joulecodeenv

# --- Measurement --------------------------------------------------------------------------
# Energy back-end for measure, optimize and serve: auto | metrion | metrion-legacy |
# metrion-live | rapl | cgroup. `auto` picks the most accurate one that is ready.
# On a machine without energy counters set "cgroup" (CPU time instead of energy).
# export JOULECODE_BACKEND="auto"

# --- Language model (optimize, serve) -----------------------------------------------------
export JOULECODE_OLLAMA_HOST="http://localhost:11434"
export JOULECODE_OLLAMA_MODEL="qwen2.5-coder:14b"     # see docs/installation.md#which-language-model

# --- METRION (written by scripts/install.sh) ----------------------------------------------
export JOULECODE_METRION_BIN="/opt/metrion/.venv/bin/metrion"       # METRION >= 0.2
export JOULECODE_METRION_DIR="/var/lib/metrion"                     # METRION >= 0.2
export JOULECODE_METRION_SERVICE="joulecode-metrion.service"
# export JOULECODE_METRION_DB="/var/lib/metrion/monitor.db"          # METRION < 0.2
# export JOULECODE_METRION_PYTHON="/opt/metrion/.venv/bin/python"    # METRION < 0.2
# export JOULECODE_METRION_RESULTS="/var/lib/metrion/energy*"        # back-end metrion-live

# --- Platform server (joulecode serve) ----------------------------------------------------
# export JOULECODE_DATA="$HOME/.joulecode/server"
# export JOULECODE_ADMIN_TOKEN=""        # fixed admin token instead of a generated one

# --- Client (joulecode submit) – then `joulecode submit` needs no connection options ------
# export JOULECODE_SERVER="http://127.0.0.1:8765"
# export JOULECODE_PROJECT=""            # project key, e.g. "myapp"
# export JOULECODE_TOKEN=""              # project token (gcp_…); keep this file private then

# --- Development: language tools without Docker (see CONTRIBUTING.md) ---------------------
# export JOULECODE_PHP_TOOLS=local
# export JOULECODE_PHP_AUTOLOAD="/path/to/vendor/autoload.php"
# export JOULECODE_JS_TOOLS=local
# export JOULECODE_JS_NODE_MODULES="/path/to/node_modules"
# export JOULECODE_JAVA_TOOLS=local
# export JOULECODE_JAVA_CLASSPATH="/path/to/classes:/path/to/javaparser.jar"
# export JOULECODE_PMD="/path/to/pmd"
